# ──────────────────────────────────────────────────────────────────────────
# .htaccess للجذر العام (public/)
# ──────────────────────────────────────────────────────────────────────────

# تعطيل عرض محتويات المجلدات
Options -Indexes

# تفعيل محرك إعادة الكتابة
RewriteEngine On

# إعادة توجيه الجذر إلى login.html (إن وُجد)
DirectoryIndex login.html index.html

# منع الوصول إلى الملفات الحساسة إذا تم وضعها هنا بالخطأ
<FilesMatch "(\.env|composer\.json|composer\.lock|Dockerfile|\.gitignore|\.htaccess)$">
    Require all denied
</FilesMatch>

# ──────────────────────────────────────────────────────────────────────────
# رؤوس أمنية أساسية
# ──────────────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # منع تخزين صفحات الإدارة في الكاش
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
    # تخزين الأصول الثابتة لمدة طويلة
    <FilesMatch "\.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|gif|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# ──────────────────────────────────────────────────────────────────────────
# ضغط المخرجات
# ──────────────────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
